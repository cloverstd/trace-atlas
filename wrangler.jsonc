{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trace-atlas",
  "workers_dev": true,
  "preview_urls": false,
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  // Preserve runtime plain-text vars (APP_ORIGIN, RP_ID) managed in Cloudflare Dashboard.
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trace-atlas",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "trace-atlas",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "env": {
    "e2e": {
      "name": "trace-atlas-e2e",
      "routes": [],
      "vars": {
        "APP_ORIGIN": "http://localhost:5174",
        "RP_ID": "localhost",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "trace-atlas-e2e",
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "trace-atlas-e2e",
        },
      ],
      "triggers": {
        "crons": [],
      },
    },
  },
}
